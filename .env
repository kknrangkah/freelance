# ============================================================================
# KONFIGURASI ENVIRONMENT STREAMBIZ / KINGSTREAM (AKSES BERSAMA / MULTI-DEVICE)
# ============================================================================

# Host Server:
# Gunakan 0.0.0.0 agar aplikasi bisa diakses bersama oleh perangkat lain
# (HP, Laptop, PC lain) di jaringan Wi-Fi / LAN yang sama maupun IP Publik/VPS.
HOST=0.0.0.0

# Port Terpisah antara Web Pelanggan (User) & Panel Admin:
USER_PORT=3000
ADMIN_PORT=3001

# URL Publik (Opsional - Isi jika menggunakan Domain / Tunnel / VPS Publik)
# Contoh: https://video.domainanda.com
PUBLIC_USER_URL=
PUBLIC_ADMIN_URL=

# Pengaturan Keamanan & CORS (Akses Lintas Perangkat)
CORS_ORIGIN=*

# Batas Maksimal Ukuran Upload File Video (dalam MB)
MAX_UPLOAD_MB=500

# Akun Default Admin (Digunakan saat inisialisasi database pertama kali)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin123
ADMIN_DEFAULT_NAME=Administrator Utama

