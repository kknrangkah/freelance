{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM"],
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": [
    "server.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "component/**/*.ts",
    "component/**/*.tsx",
    "context/**/*.ts",
    "context/**/*.tsx",
    "lib/**/*.ts",
    "scripts/**/*.ts",
    "types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "public", "uploads"]
}
